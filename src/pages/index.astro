      <!-- Script de Rotación Autónoma para Hardware Farmnavigator -->
      <script is:inline>
        const farmPanels = document.querySelectorAll('.farm-panel');
        const farmHardwares = document.querySelectorAll('.farm-hardware');
        const farmTabs = document.querySelectorAll('.farm-tab');
        const farmTracks = document.querySelectorAll('.farm-track');
        const farmBars = document.querySelectorAll('.farm-bar');
        const farmAura = document.getElementById('farm-aura');
        const farmCounter = document.getElementById('farm-counter');
        const farmTheater = document.getElementById('farmnavigator-theater');
        const farmPrev = document.getElementById('farm-prev');
        const farmNext = document.getElementById('farm-next');
        const isobusBanner = document.getElementById('isobus-banner');
        const isobusDetails = document.getElementById('isobus-details');
        const isobusChevron = document.getElementById('isobus-chevron');

        let farmCurrent = 0;
        const FARM_TOTAL = 5;
        const FARM_INTERVAL = 6000;
        let farmProgress = 0;
        let farmTimer = null;
        let farmIsPaused = false;
        let farmInView = true;

        function updateFarmSlide(index) {
          farmCurrent = (index + FARM_TOTAL) % FARM_TOTAL;
          farmProgress = 0;

          farmPanels.forEach((p, idx) => {
            if (idx === farmCurrent) {
              p.classList.remove('opacity-0', 'translate-x-8', 'pointer-events-none', 'absolute', 'inset-0');
              p.classList.add('opacity-100', 'translate-x-0', 'relative');
              const color = p.getAttribute('data-color');
              if (farmAura && color) farmAura.style.backgroundColor = color;
            } else {
              p.classList.add('opacity-0', 'translate-x-8', 'pointer-events-none', 'absolute', 'inset-0');
              p.classList.remove('opacity-100', 'translate-x-0', 'relative');
            }
          });

          farmHardwares.forEach((h, idx) => {
            if (idx === farmCurrent) {
              h.classList.remove('opacity-0', 'scale-75', 'pointer-events-none');
              h.classList.add('opacity-100', 'scale-100');
            } else {
              h.classList.add('opacity-0', 'scale-75', 'pointer-events-none');
              h.classList.remove('opacity-100', 'scale-100');
            }
          });

          farmTabs.forEach((tab, idx) => {
            const color = farmPanels[farmCurrent].getAttribute('data-color') || '#0082C8';
            if (idx === farmCurrent) {
              tab.className = 'farm-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all border whitespace-nowrap';
              tab.style.backgroundColor = `${color}25`;
              tab.style.color = '#7DD3FC';
              tab.style.borderColor = `${color}80`;
            } else {
              tab.className = 'farm-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap';
              tab.style.backgroundColor = '';
              tab.style.color = '';
              tab.style.borderColor = '';
            }
          });

          farmBars.forEach((bar, idx) => {
            if (idx < farmCurrent) bar.style.width = '100%';
            else bar.style.width = '0%';
          });

          if (farmCounter) {
            farmCounter.textContent = `0${farmCurrent + 1} / 0${FARM_TOTAL}`;
          }
        }

        function startFarmLoop() {
          clearInterval(farmTimer);
          farmTimer = setInterval(() => {
            if (!farmIsPaused && farmInView) {
              farmProgress += 50;
              const pct = Math.min((farmProgress / FARM_INTERVAL) * 100, 100);
              if (farmBars[farmCurrent]) farmBars[farmCurrent].style.width = `${pct}%`;
              if (farmProgress >= FARM_INTERVAL) updateFarmSlide(farmCurrent + 1);
            }
          }, 50);
        }

        farmTabs.forEach(t => t.addEventListener('click', () => updateFarmSlide(parseInt(t.getAttribute('data-target')))));
        farmTracks.forEach(tr => tr.addEventListener('click', () => updateFarmSlide(parseInt(tr.getAttribute('data-target')))));
        if (farmPrev) farmPrev.addEventListener('click', () => updateFarmSlide(farmCurrent - 1));
        if (farmNext) farmNext.addEventListener('click', () => updateFarmSlide(farmCurrent + 1));

        if (isobusBanner && isobusDetails) {
          isobusBanner.addEventListener('click', () => {
            const isOpen = isobusDetails.classList.contains('max-h-96');
            if (isOpen) {
              isobusDetails.classList.remove('max-h-96', 'opacity-100', 'mt-4', 'pt-4');
              if (isobusChevron) isobusChevron.classList.remove('rotate-180');
            } else {
              isobusDetails.classList.add('max-h-96', 'opacity-100', 'mt-4', 'pt-4');
              if (isobusChevron) isobusChevron.classList.add('rotate-180');
            }
          });
        }

        if (farmTheater) {
          farmTheater.addEventListener('mouseenter', () => { farmIsPaused = true; });
          farmTheater.addEventListener('mouseleave', () => { farmIsPaused = false; });
          
          let touchStartX = 0;
          let touchEndX = 0;
          farmTheater.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
          farmTheater.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchStartX - touchEndX > 50) updateFarmSlide(farmCurrent + 1);
            else if (touchEndX - touchStartX > 50) updateFarmSlide(farmCurrent - 1);
          }, { passive: true });
        }

        const farmContainer = document.getElementById("farm-panels-container");
        function lockFarmHeight() {
          if (!farmContainer || !farmPanels.length) return;
          let maxH = 0;
          farmPanels.forEach((p) => {
            const wasAbs = p.classList.contains("absolute");
            const prevVis = p.style.visibility;
            p.style.visibility = "hidden";
            if (wasAbs) { p.classList.remove("absolute", "inset-0"); p.classList.add("relative"); }
            maxH = Math.max(maxH, p.offsetHeight);
            if (wasAbs) { p.classList.add("absolute", "inset-0"); p.classList.remove("relative"); }
            p.style.visibility = prevVis;
          });
          if (maxH > 0) farmContainer.style.minHeight = maxH + "px";
        }
        lockFarmHeight();
        window.addEventListener("resize", lockFarmHeight, { passive: true });
        if (farmTheater && "IntersectionObserver" in window) {
          new IntersectionObserver((entries) => {
            farmInView = entries[0].isIntersecting;
          }, { threshold: 0.05 }).observe(farmTheater);
        }
        updateFarmSlide(0);
        startFarmLoop();
      </script>
