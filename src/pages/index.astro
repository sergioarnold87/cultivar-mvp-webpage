---
import RtkProSection from '../components/RtkProSection.astro';
// Cultivar S.A. - Landing Page Oficial (Clean Tech B2B)
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Cultivar S.A. | Sistemas Ciberfísicos & Tecnología Agronómica · Itapúa</title>
  <meta name="description" content="Ingeniería ciberfísica aplicada al agro: nutrición fisiológica Sercrop, hardware ISOBUS Farmnavigator, señal RTKPro ±2 cm y telemetría en Itapúa.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-[#070D0B] text-white antialiased min-h-screen flex flex-col selection:bg-[#18D253] selection:text-[#041108]">

  <!-- NAVBAR CLEAN TECH -->
  <header class="sticky top-0 z-50 bg-[#070D0B]/90 backdrop-blur-md border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <a href="#inicio" class="relative inline-flex items-center justify-center py-1.5 px-3 transition-transform hover:scale-105">
        <span class="absolute -inset-1 rounded-full pointer-events-none animate-pulse" style="background: radial-gradient(ellipse at center, rgba(24,210,83,0.26) 0%, rgba(163,230,53,0.10) 50%, transparent 75%);"></span>
        <img src="/images/cultivar-logo.png" alt="Cultivar S.A." class="relative z-10 h-12 w-auto object-contain sercrop-neon-aura">
      </a>
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-300">
        <a href="#quienes-somos" class="hover:text-[#18D253] transition-colors">Sistemas Ciberfísicos</a>
        <a href="#sercrop" class="hover:text-[#18D253] transition-colors">Línea Sercrop</a>
        <a href="#hardware" class="hover:text-[#00F0FF] transition-colors">Hardware & RTK</a>
        <a href="#rtkpro" class="hover:text-[#00F0FF] transition-colors">Señal RTK PRO</a>
        <a href="#inteligencia" class="hover:text-[#00F0FF] transition-colors">Telemetría & IA</a>
      </nav>
      <a href="https://wa.me/595975679274?text=Hola%20Cultivar%2C%20quisiera%20contactar%20con%20un%20asesor%20t%C3%A9cnico." target="_blank" rel="noopener noreferrer" class="rounded-full px-5 py-2 font-bold text-xs uppercase tracking-wider text-slate-200 border border-white/20 hover:border-[#18D253] hover:text-white transition-all inline-flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#18D253]"></span>
        <span>Contacto Directo</span>
      </a>
    </div>
  </header>

  <main class="flex-grow">

    <!-- 01 · HERO STAGE LIMPIO (CLEAN TECH B2B) -->
    <section id="inicio" class="relative min-h-[85vh] flex items-center bg-[#070D0B] border-b border-white/10 overflow-hidden">
      
      <!-- Fondo Visual Ciberfísico Oscurecido -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/imagen-tractor-siembra.webp" 
          alt="Agricultura de precisión y telemetría en campo" 
          class="w-full h-full object-cover object-center opacity-50"
        />
        <!-- Máscara direccional para lectura nítida al 50% izquierdo y escena despejada a la derecha -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#070D0B] via-[#070D0B]/85 to-[#070D0B]/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#070D0B] via-transparent to-[#070D0B]/50"></div>
      </div>

      <!-- Contenedor Principal (Alineado a la izquierda, 50% de pantalla) -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10 w-full">
        <div class="max-w-2xl text-left">
          <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black text-white tracking-tight leading-[1.08] mb-6">
            Ingeniería de precisión para el <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#18D253] to-[#00F0FF]">control total</span> de cada hectárea.
          </h1>

          <h2 class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8 max-w-xl">
            Integramos biotecnología foliar <strong class="text-white font-semibold">Sercrop</strong>, automatización ISOBUS <strong class="text-white font-semibold">Farmnavigator</strong> y señal satelital <strong class="text-white font-semibold">RTKPro (±2 cm)</strong> con soporte técnico permanente en campo.
          </h2>

          <a href="#quienes-somos" class="text-xs font-bold uppercase tracking-widest text-slate-300 hover:text-[#18D253] transition inline-flex items-center gap-2.5 py-2">
            <span>Explorar Ecosistema</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 02 · QUIÉNES SOMOS (LA DIVISIÓN LÓGICA · BENTO BOX 4 PILARES) -->
    <section id="quienes-somos" class="py-20 lg:py-28 bg-[#0B1210] border-b border-white/10 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-gradient-to-r from-[#18D253]/10 via-[#00F0FF]/10 to-transparent blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Encabezado Introductorio Centrado -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#00F0FF] block mb-3">
            Arquitectura Integral de Producción
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-5">
            Sistemas Ciberfísicos: Innovación y control agronómico
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-[#18D253] to-[#00F0FF] mx-auto rounded-full mb-6"></div>
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
            En <strong>Cultivar</strong> conectamos la biología del cultivo con la automatización mecatrónica y los datos en la nube. Integramos cuatro pilares tecnológicos bajo un mismo respaldo técnico local en Itapúa para transformar cada variable del lote en rentabilidad medible.
          </p>
        </div>

        <!-- Bento Grid de 4 Pilares con Iconografía Vectorial SVG -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Pilar 1: Nutrición (Sercrop) -->
          <div class="group rounded-3xl bg-[#101916] border border-white/10 p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-[#18D253]/70 hover:shadow-[0_10px_35px_rgba(24,210,83,0.14)]">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-2xl bg-[#18D253]/10 border border-[#18D253]/30 text-[#18D253] flex items-center justify-center group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m-3-3h6"/>
                  </svg>
                </div>
                <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-[#18D253] transition-colors">01 · BIO</span>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#18D253] block mb-1">Sercrop Fisiología</span>
              <h3 class="text-xl font-extrabold text-white mb-3">Nutrición de Alta Respuesta</h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Bioestimulantes hormonales, protectores multisitio y coadyuvantes ULV formulados para blindar el potencial genético ante estrés hídrico o térmico.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-white">
              <span>Manejo Fisiológico</span>
              <a href="#sercrop" class="text-[#18D253] hover:underline">Ver línea →</a>
            </div>
          </div>

          <!-- Pilar 2: Antenas All-in-One & Monitor G12 -->
          <div class="group rounded-3xl bg-[#101916] border border-white/10 p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-[#00A3FF]/70 hover:shadow-[0_10px_35px_rgba(0,163,255,0.14)]">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-2xl bg-[#00A3FF]/10 border border-[#00A3FF]/30 text-[#00A3FF] flex items-center justify-center group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <rect x="2" y="5" width="20" height="12" rx="2.5"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M6 11h4m4 0h4"/>
                  </svg>
                </div>
                <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-[#00A3FF] transition-colors">02 · HARDWARE</span>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#00A3FF] block mb-1">Farmnavigator AvMap</span>
              <h3 class="text-xl font-extrabold text-white mb-3">Antenas All-in-One y Monitor G12</h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Antenas inteligentes que integran receptor multifrecuencia, módem 4G y compensación inercial IMU sin cajas externas, junto al monitor panorámico <strong class="text-slate-200">G12</strong> ("dos pantallas en una", 1000 nits, IPX6 y miembro AEF compatible con cualquier marca).
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-white">
              <span>Multimarca · Sin Cajas Extra</span>
              <a href="#hardware" class="text-[#00A3FF] hover:underline">Ver equipos →</a>
            </div>
          </div>

          <!-- Pilar 3: Señal RTKPro vía Starlink -->
          <div class="group rounded-3xl bg-[#101916] border border-white/10 p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-[#00F0FF]/70 hover:shadow-[0_10px_35px_rgba(0,240,255,0.14)]">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-2xl bg-[#00F0FF]/10 border border-[#00F0FF]/30 text-[#00F0FF] flex items-center justify-center group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-[#00F0FF] transition-colors">03 · SEÑAL RTK</span>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#00F0FF] block mb-1">Red RTKPro NTRIP</span>
              <h3 class="text-xl font-extrabold text-white mb-3">Precisión Real ±2 cm vía Starlink</h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Corrección centimétrica en tiempo real conectada por <strong class="text-slate-200">internet satelital Starlink</strong> o red celular multired. Garantiza repetibilidad exacta surco sobre surco en zonas sin cobertura móvil, eliminando la inversión y mantenimiento de antenas base fijas en el campo.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-white">
              <span>Cobertura Total · Sin Base Fija</span>
              <a href="#hardware" class="text-[#00F0FF] hover:underline">Ver señal →</a>
            </div>
          </div>

          <!-- Pilar 4: Drones, IoT, Penetrómetros, Telemática y Cloud -->
          <div class="group rounded-3xl bg-[#101916] border border-white/10 p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-400/70 hover:shadow-[0_10px_35px_rgba(16,185,129,0.14)]">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-2xl bg-emerald-400/10 border border-emerald-400/30 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h4m10 0h4M5 7l3 4h8l3-4M8 11l-2 6m10-6l2 6M9 15h6"/>
                  </svg>
                </div>
                <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-emerald-400 transition-colors">04 · DATOS & CLOUD</span>
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 block mb-1">Drones, IoT & Telemática</span>
              <h3 class="text-xl font-extrabold text-white mb-3">Sensores, Penetrómetros y Nube</h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Integramos relevamientos con <strong class="text-slate-200">drones</strong>, sensores IoT, <strong class="text-slate-200">penetrómetros</strong> digitales de compactación y telemática CANBus en vivo. Los datos convergen en plataformas cloud como <strong class="text-slate-200">MyFarmnavigator</strong> y <strong class="text-slate-200">DJI SmartFarm</strong> para generar mapas de prescripción y ejecutar decisiones precisas en el lote.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-white">
              <span>Diagnóstico & Cloud Sync</span>
              <a href="#inteligencia" class="text-emerald-400 hover:underline">Ver flujo →</a>
            </div>
          </div>

        </div>

      </div>
    </section>

<!-- LÍNEA SERCROP: TEATRO DE ROTACIÓN AUTOMÁTICA -->
    <section id="sercrop" class="py-16 lg:py-20 bg-[#050B07] text-white relative overflow-hidden select-none">
      <div id="sercrop-theater" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <!-- Encabezado con Logo Sercrop Nutrición en un costado y aura verde pulsante -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-white/10 pb-6 mb-6">
          <div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">Línea Sercrop Fisiología</h2>
          </div>

          <!-- LOGO SERCROP NUTRICIÓN: Transparente, tipografía blanca y aura verde pulsante -->
          <div class="relative inline-flex items-center justify-center self-start md:self-center px-5 py-3 shrink-0">
            <div class="absolute -inset-3 rounded-full pointer-events-none animate-pulse" style="background: radial-gradient(ellipse at center, rgba(24,210,83,0.28) 0%, rgba(163,230,53,0.12) 48%, transparent 74%);"></div>
            <img 
              src="/images/sercrop/sercrop_logo.webp" 
              alt="Sercrop Nutrición" 
              class="relative z-10 w-52 sm:w-60 md:w-68 h-auto object-contain sercrop-neon-aura"
            />
          </div>
        </div>

        <!-- Barra de Pestañas de Productos -->
        <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none">
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all bg-[#00D2D3]/20 text-[#00D2D3] border border-[#00D2D3]/40 whitespace-nowrap" data-target="0">Cobre-Ni</button>
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap" data-target="1">Force</button>
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap" data-target="2">Fix</button>
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap" data-target="3">Citrus</button>
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap" data-target="4">Aero-Tech</button>
          <button class="sercrop-tab px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5 whitespace-nowrap" data-target="5">Fixer Oil</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center min-h-[520px]">
          <div class="lg:col-span-7 relative h-[440px] sm:h-[460px] flex items-center z-20">
            <!-- 1. Cobre-Ni -->
            <div class="sercrop-panel absolute inset-0 flex flex-col justify-center transition-all duration-700 opacity-100 translate-x-0" data-index="0" data-color="#00D2D3">
              <span class="text-xs font-extrabold uppercase tracking-widest text-[#00D2D3] mb-2">Escudo Sistémico Multisitio</span>
              <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-4">CROP COBRE-NI</h3>
              <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mb-6">
                Fungicida/bactericida multisitio. Ataca a la célula fúngica en diferentes regiones, evitando que la enfermedad cree resistencia a productos sistémicos.
              </p>
              <div class="grid grid-cols-2 gap-4 mb-8 max-w-xl">
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-md">
                  <span class="block text-[#00D2D3] text-xs font-bold uppercase mb-1">Composición Química</span>
                  <ul class="text-xs text-slate-300 space-y-1 font-mono">
                    <li>• P2O5: 10% | Cu: 5%</li>
                    <li>• Ni: 2% | Boro: 0.5%</li>
                    <li>• Citoquinina: 0.1%</li>
                  </ul>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-md">
                  <span class="block text-[#00D2D3] text-xs font-bold uppercase mb-1">Recomendación Dosis</span>
                  <div class="text-2xl font-black text-white">300 - 350 <span class="text-xs font-normal text-slate-400">ml/ha</span></div>
                  <span class="text-xs text-slate-400">Soja (Vn-R3), Canola, Trigo</span>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <a href="https://wa.me/595975679274?text=Hola,%20solicito%20cotizacion%20de%20CROP%20COBRE-NI" target="_blank" class="btn-whatsapp-glow">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.03-.967-.272-.099-.47-.148-.669.15-.198.297-.768.966-.941 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
                  <span>Cotizar Cobre-Ni</span>
                </a>
              </div>
            </div>

            <!-- 2. Force -->
            <div class="sercrop-panel absolute inset-0 flex flex-col justify-center transition-all duration-700 opacity-0 translate-x-8 pointer-events-none" data-index="1" data-color="#18D253">
              <span class="text-xs font-extrabold uppercase tracking-widest text-[#18D253] mb-2">Desarrollo Radicular & F.B.N.</span>
              <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-4">CROP FORCE</h3>
              <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mb-6">
                Enraizante con minerales (Co, Mo) y hormonas. Promueve el desarrollo y fisiología vegetal, aumentando la Fijación Biológica de Nitrógeno.
              </p>
              <div class="grid grid-cols-2 gap-4 mb-8 max-w-xl">
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-md">
                  <span class="block text-[#18D253] text-xs font-bold uppercase mb-1">Balance Hormonal</span>
                  <ul class="text-xs text-slate-300 space-y-1 font-mono">
                    <li>• Cobalto (1.0%) | Mo (10.7%)</li>
                    <li>• Auxinas (AIA) | Citoquinina</li>
                    <li>• Giberelina (GA3)</li>
                  </ul>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-md">
