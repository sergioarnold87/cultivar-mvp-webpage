      <script is:inline>
        const panels = document.querySelectorAll('.sercrop-panel');
        const bottles = document.querySelectorAll('.sercrop-bottle');
        const tabs = document.querySelectorAll('.sercrop-tab');
        const tracks = document.querySelectorAll('.sercrop-progress-track');
        const bars = document.querySelectorAll('.sercrop-progress-bar');
        const aura = document.getElementById('sercrop-aura');
        const counter = document.getElementById('counter-display');
        const theater = document.getElementById('sercrop-theater');
        const prevBtn = document.getElementById('btn-prev');
        const nextBtn = document.getElementById('btn-next');

        let current = 0;
        const TOTAL = 6;
        const INTERVAL_TIME = 6000;
        let progress = 0;
        let timer = null;
        let isPaused = false;

        function updateSlide(index) {
          current = (index + TOTAL) % TOTAL;
          progress = 0;

          // 1. Paneles de texto
          panels.forEach((p, idx) => {
            if (idx === current) {
              p.classList.remove('opacity-0', 'translate-x-8', 'pointer-events-none');
              p.classList.add('opacity-100', 'translate-x-0');
              const color = p.getAttribute('data-color');
              if (aura && color) aura.style.backgroundColor = color;
            } else {
              p.classList.add('opacity-0', 'translate-x-8', 'pointer-events-none');
              p.classList.remove('opacity-100', 'translate-x-0');
            }
          });

          // 2. Botellas
          bottles.forEach((b, idx) => {
            if (idx === current) {
              b.classList.remove('opacity-0', 'scale-75', 'pointer-events-none');
              b.classList.add('opacity-100', 'scale-100');
            } else {
              b.classList.add('opacity-0', 'scale-75', 'pointer-events-none');
              b.classList.remove('opacity-100', 'scale-100');
            }
          });

          // 3. Pestañas
          tabs.forEach((tab, idx) => {
            const color = panels[current].getAttribute('data-color') || '#00D2D3';
            if (idx === current) {
              tab.className = `sercrop-tab px-3 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all border`;
              tab.style.backgroundColor = `${color}25`;
              tab.style.color = color;
              tab.style.borderColor = `${color}60`;
            } else {
              tab.className = 'sercrop-tab px-3 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white hover:bg-white/5';
              tab.style.backgroundColor = '';
              tab.style.color = '';
              tab.style.borderColor = '';
            }
          });

          // 4. Barras de progreso
          bars.forEach((bar, idx) => {
            if (idx < current) {
              bar.style.width = '100%';
            } else if (idx === current) {
              bar.style.width = '0%';
            } else {
              bar.style.width = '0%';
            }
          });

          // 5. Contador
          if (counter) {
            counter.textContent = `0${current + 1} / 0${TOTAL}`;
          }
        }

        // Bucle de animación suave (cada 50ms)
        function startLoop() {
          clearInterval(timer);
          timer = setInterval(() => {
            if (!isPaused) {
              progress += 50;
              const pct = Math.min((progress / INTERVAL_TIME) * 100, 100);
              if (bars[current]) bars[current].style.width = `${pct}%`;

              if (progress >= INTERVAL_TIME) {
                updateSlide(current + 1);
              }
            }
          }, 50);
        }

        // Controles de Pestañas y Barras
        tabs.forEach(t => {
          t.addEventListener('click', () => {
            const target = parseInt(t.getAttribute('data-target'));
            updateSlide(target);
          });
        });

        tracks.forEach(tr => {
          tr.addEventListener('click', () => {
            const target = parseInt(tr.getAttribute('data-target'));
            updateSlide(target);
          });
        });

        // Flechas Prev / Next
        if (prevBtn) prevBtn.addEventListener('click', () => updateSlide(current - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => updateSlide(current + 1));

        // Pausa al pasar el mouse por encima
        if (theater) {
          theater.addEventListener('mouseenter', () => { isPaused = true; });
          theater.addEventListener('mouseleave', () => { isPaused = false; });
        }

        // Soporte Swipe Táctil (Móvil / Tablet)
        let touchStartX = 0;
        let touchEndX = 0;

        if (theater) {
          theater.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          theater.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchStartX - touchEndX > 50) {
              // Swipe izquierda -> siguiente
              updateSlide(current + 1);
            } else if (touchEndX - touchStartX > 50) {
              // Swipe derecha -> anterior
              updateSlide(current - 1);
            }
          }, { passive: true });
        }

        // Inicializar
        updateSlide(0);
        startLoop();
      </script>
