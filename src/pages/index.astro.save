  <!-- SCRIPT MATEMÁTICO DETERMINISTA: Conmuta el 100% de la pantalla sin retraso -->
  <script is:inline>
    const container = document.getElementById('sercrop-stage-container');
    const slides = document.querySelectorAll('.sercrop-slide');
    const bottles = document.querySelectorAll('.sercrop-stage-bottle');
    const aura = document.getElementById('sercrop-aura');
    const counter = document.getElementById('active-step-num');
    const bars = document.querySelectorAll('.sercrop-indicator-bar');

    let currentIndex = -1;

    function handleStageScroll() {
      if (!container) return;
      const rect = container.getBoundingClientRect();
      const scrollableHeight = container.offsetHeight - window.innerHeight;
      
      // Si la sección aún no entra o ya pasó, no calcular
      if (rect.top > 0 || rect.bottom < window.innerHeight) return;

      // Progreso continuo de 0 a 1 dentro de los 600vh
      const progress = Math.min(Math.max(-rect.top / scrollableHeight, 0), 0.999);
      const newIndex = Math.floor(progress * 6);

      if (newIndex !== currentIndex) {
        currentIndex = newIndex;

        // 1. Conmutar textos de producto
        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.remove('opacity-0', 'translate-y-6', 'pointer-events-none');
            slide.classList.add('opacity-100', 'translate-y-0');
            const color = slide.getAttribute('data-color');
            if (aura && color) aura.style.backgroundColor = color;
          } else {
            slide.classList.add('opacity-0', 'translate-y-6', 'pointer-events-none');
            slide.classList.remove('opacity-100', 'translate-y-0');
          }
        });

        // 2. Conmutar botella activa
        bottles.forEach((bottle, idx) => {
          if (idx === currentIndex) {
            bottle.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
            bottle.classList.add('opacity-100', 'scale-100');
          } else {
            bottle.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            bottle.classList.remove('opacity-100', 'scale-100');
          }
        });

        // 3. Actualizar contador numérico (01 a 06)
        if (counter) {
          counter.textContent = `0${currentIndex + 1}`;
        }

        // 4. Actualizar barra de progreso
        bars.forEach((bar, idx) => {
          if (idx === currentIndex) {
            const activeColor = slides[currentIndex].getAttribute('data-color') || '#EA580C';
            bar.style.backgroundColor = activeColor;
            bar.classList.remove('bg-white/20');
          } else {
            bar.style.backgroundColor = '';
            bar.classList.add('bg-white/20');
          }
        });
      }
    }

    window.addEventListener('scroll', handleStageScroll, { passive: true });
    window.addEventListener('resize', handleStageScroll);
    handleStageScroll();
  </script>
</section>
