---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cultivar S.A. | Tecnología Agronómica · Bella Vista, Itapúa">
  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/cultivar-logo.jpeg" alt="Cultivar S.A." class="h-12 w-auto object-contain" />
      </a>
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-700">
        <a href="#quienes-somos" class="hover:text-[#1B4332] transition-colors">Quiénes Somos</a>
        <a href="#sercrop" class="hover:text-[#1B4332] transition-colors">Línea Sercrop</a>
        <a href="#hardware" class="hover:text-[#1B4332] transition-colors">Hardware & RTK</a>
        <a href="#inteligencia" class="hover:text-[#1B4332] transition-colors">Telemetría & IA</a>
      </nav>
      <a href="https://wa.me/595975679274" target="_blank" rel="noopener noreferrer" class="rounded-full px-6 py-2.5 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] shadow-sm transition-all inline-flex items-center gap-2">
        <span>Contactar Asesor</span>
      </a>
    </div>
  </header>

  <main class="flex-grow">
    <!-- QUIÉNES SOMOS RENOVADO -->
    <section id="quienes-somos" class="py-16 sm:py-20 bg-[#F8FAFC] border-b border-slate-200 relative overflow-hidden bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px]">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-4xl h-80 bg-[#1B4332]/5 blur-3xl rounded-full pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl mx-auto bg-white/90 backdrop-blur-md rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm mb-12 relative">
          <div class="text-center">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1B4332]/10 border border-[#1B4332]/20 text-[#1B4332] text-xs font-bold uppercase tracking-wider mb-4">
              <span class="w-2 h-2 rounded-full bg-[#EA580C]"></span>
              INTEGRACIÓN AGRONÓMICA & AGRICULTURA DE PRECISIÓN
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E293B] tracking-tight mb-3">Aliados estratégicos en cada etapa de su ciclo productivo</h2>
            <div class="w-16 h-1 bg-[#1B4332] mx-auto rounded-full mb-6"></div>
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal max-w-3xl mx-auto mb-8">
              En <strong>Cultivar S.A.</strong> transformamos los desafíos del lote en resultados medibles y sostenibles. Integramos fisiología vegetal de alta gama, automatización de maquinaria ISOBUS y conectividad satelital, respaldados por servicio técnico permanente en Itapúa.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-100 text-left">
              <div class="flex items-center gap-3 p-2">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#1B4332] flex items-center justify-center font-bold text-lg">🌾</div>
                <div><h4 class="text-xs font-bold text-[#1E293B] uppercase">Nutrición Sercrop</h4><p class="text-[11px] text-slate-500">Manejo fisiológico avanzado</p></div>
              </div>
              <div class="flex items-center gap-3 p-2">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-lg">🛰️</div>
                <div><h4 class="text-xs font-bold text-[#1E293B] uppercase">Farmnavigator & RTK</h4><p class="text-[11px] text-slate-500">Distribuidores y Soporte Oficial</p></div>
              </div>
              <div class="flex items-center gap-3 p-2">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-lg">📊</div>
                <div><h4 class="text-xs font-bold text-[#1E293B] uppercase">Telemetría IoT</h4><p class="text-[11px] text-slate-500">Datos y monitoreo Cloud</p></div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all border-t-4 border-[#1B4332]">
            <div class="flex justify-between items-start mb-5">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#1B4332] flex items-center justify-center font-bold text-2xl shadow-inner">🌱</div>
              <span class="text-xs font-mono font-bold text-slate-400">01</span>
            </div>
            <h3 class="text-xl font-bold text-[#1E293B] mb-2">Innovación</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Prácticas y formulaciones para responder a las exigencias agronómicas del clima regional.</p>
          </div>
          <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all border-t-4 border-[#1B4332]">
            <div class="flex justify-between items-start mb-5">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-2xl shadow-inner">🚜</div>
              <span class="text-xs font-mono font-bold text-slate-400">02</span>
            </div>
            <h3 class="text-xl font-bold text-[#1E293B] mb-2">Tecnología</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Incorporamos herramientas digitales y hardware RTK que maximizan el rendimiento operativo de su maquinaria.</p>
          </div>
          <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all border-t-4 border-[#1B4332]">
            <div class="flex justify-between items-start mb-5">
              <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-800 flex items-center justify-center font-bold text-2xl shadow-inner">🌍</div>
              <span class="text-xs font-mono font-bold text-slate-400">03</span>
            </div>
            <h3 class="text-xl font-bold text-[#1E293B] mb-2">Sustentabilidad</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Cuidado del suelo y eficiencia en insumos para que la productividad actual perdure en las próximas campañas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LÍNEA SERCROP -->
    <section id="sercrop" class="py-20 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-[#EA580C] font-bold text-xs uppercase tracking-widest">Nutrición de Alta Expresión Genética</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E293B] mt-2 mb-3">Línea Sercrop Fisiología</h2>
          <div class="w-16 h-1 bg-[#1B4332] mx-auto rounded-full mb-6"></div>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="https://wa.me/595975679274?text=Hola,%20solicito%20informacion%20completa%20sobre%20la%20gama%20de%20productos%20Sercrop" target="_blank" rel="noopener noreferrer" class="rounded-full px-7 py-3 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] shadow-sm transition-all inline-flex items-center gap-2">
              <span>Conozca toda nuestra gama de productos</span>
            </a>
            <a href="/docs/linea-sercrop.pdf" target="_blank" rel="noopener noreferrer" class="rounded-full px-6 py-3 font-bold text-xs uppercase tracking-wider text-[#1B4332] bg-slate-50 border border-[#1B4332]/30 transition-all inline-flex items-center gap-2">
              <span>Descargar Ficha Técnica Sercrop (PDF)</span>
            </a>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm border-t-4 border-[#1B4332]">
            <div class="h-60 bg-slate-50 flex items-center justify-center p-4"><img src="/images/crop-cobre-ni.jpeg" alt="Crop-Cobre-Ni" class="max-h-full max-w-full object-contain" /></div>
            <div class="p-6"><h3 class="text-xl font-bold text-[#1E293B] mb-2">Crop-Cobre-Ni</h3><p class="text-sm text-slate-600 mb-4">Bioestimulación sistémica, sanidad y balance mineral. Superación de estrés y llenado de granos.</p></div>
            <div class="p-6 pt-0"><a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Cobre-Ni" target="_blank" class="w-full rounded-full py-2.5 px-4 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] text-center inline-block">Consultar Producto</a></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm border-t-4 border-[#1B4332]">
            <div class="h-60 bg-slate-50 flex items-center justify-center p-4"><img src="/images/sercrop-crop-force.jpeg" alt="Crop-Force" class="max-h-full max-w-full object-contain" /></div>
            <div class="p-6"><h3 class="text-xl font-bold text-[#1E293B] mb-2">Crop-Force</h3><p class="text-sm text-slate-600 mb-4">Bioestimulante de desarrollo radicular y respuesta rápida frente a heladas o sequía.</p></div>
            <div class="p-6 pt-0"><a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Force" target="_blank" class="w-full rounded-full py-2.5 px-4 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] text-center inline-block">Consultar Producto</a></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm border-t-4 border-[#1B4332]">
            <div class="h-60 bg-slate-50 flex items-center justify-center p-4"><img src="/images/crop-fix.jpeg" alt="Crop-Fix" class="max-h-full max-w-full object-contain" /></div>
            <div class="p-6"><h3 class="text-xl font-bold text-[#1E293B] mb-2">Crop-Fix</h3><p class="text-sm text-slate-600 mb-4">Coadyuvante adherente premium. Reduce evaporación y garantiza absorción frente a lluvias.</p></div>
            <div class="p-6 pt-0"><a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Fix" target="_blank" class="w-full rounded-full py-2.5 px-4 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] text-center inline-block">Consultar Producto</a></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm border-t-4 border-[#1B4332]">
            <div class="h-60 bg-slate-50 flex items-center justify-center p-4"><img src="/images/crop-citrus.jpeg" alt="Crop-Citrus" class="max-h-full max-w-full object-contain" /></div>
            <div class="p-6"><h3 class="text-xl font-bold text-[#1E293B] mb-2">Crop-Citrus</h3><p class="text-sm text-slate-600 mb-4">Corrector de micronutrientes quelatados específicos para frutales y cultivos de alta demanda.</p></div>
            <div class="p-6 pt-0"><a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Citrus" target="_blank" class="w-full rounded-full py-2.5 px-4 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] text-center inline-block">Consultar Producto</a></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm border-t-4 border-[#1B4332]">
            <div class="h-60 bg-slate-50 flex items-center justify-center p-4"><img src="/images/sercrop-aerotech.jpeg" alt="Aero-Tech" class="max-h-full max-w-full object-contain" /></div>
            <div class="p-6"><h3 class="text-xl font-bold text-[#1E293B] mb-2">Aero-Tech</h3><p class="text-sm text-slate-600 mb-4">Formulador para aplicaciones aéreas y de ultra bajo volumen. Homogeneidad total del caldo.</p></div>
            <div class="p-6 pt-0"><a href="https://wa.me/595975679274?text=Cotizacion%20Aero-Tech" target="_blank" class="w-full rounded-full py-2.5 px-4 font-bold text-sm text-white bg-[#EA580C] hover:bg-[#C2410C] text-center inline-block">Consultar Producto</a></div>
          </div>
        </div>
      </div>
    </section><!-- LÍNEA SERCROP INTERACTIVA (SCROLLYTELLING) -->
<section id="sercrop" class="py-24 bg-[#07100B] text-white border-b border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[#EA580C] font-bold text-xs uppercase tracking-widest">Nutrición de Alta Expresión Genética</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-3">Línea Sercrop Fisiología</h2>
      <div class="w-16 h-1 bg-[#1B4332] mx-auto rounded-full mb-6"></div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/docs/linea-sercrop.pdf" target="_blank" rel="noopener noreferrer" class="rounded-full px-6 py-3 font-bold text-xs uppercase tracking-wider text-white bg-[#1B4332] hover:bg-[#2D6A4F] transition-all inline-flex items-center gap-2">
          <span>Descargar Dossier Completo (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Escenario: Botella Fija a la Izquierda, Scroll a la Derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start relative">
      
      <!-- Columna Izquierda: Sticky (Botella fija con Aura) -->
      <div class="lg:col-span-5 hidden lg:block sticky top-28 h-[70vh]">
        <!-- Aura ambiental dinámica -->
        <div id="sercrop-glow" class="absolute inset-0 m-auto w-72 h-72 rounded-full blur-[100px] opacity-30 transition-all duration-700 pointer-events-none" style="background-color: #00D2D3;"></div>
        
        <!-- Contenedor de Botellas superpuestas -->
        <div class="relative w-full h-full flex items-center justify-center">
          <img id="img-cobre-ni" src="/images/sercrop/crop_cobre_ni_clean.png" alt="Crop Cobre-Ni" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-100 scale-100">
          <img id="img-force" src="/images/sercrop/crop_force_clean.png" alt="Crop Force" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-0 scale-95 pointer-events-none">
          <img id="img-fix" src="/images/sercrop/crop_fix_oficial.png" alt="Crop Fix" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-0 scale-95 pointer-events-none">
          <img id="img-citrus" src="/images/sercrop/crop_citrus_oficial.png" alt="Crop Citrus" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-0 scale-95 pointer-events-none">
          <img id="img-aero" src="/images/sercrop/aero_tech_drone.webp" alt="Aero Tech" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-0 scale-95 pointer-events-none">
          <img id="img-oil" src="/images/sercrop/crop_fixer_oil_clean.png" alt="Crop Fixer Oil" class="sercrop-stage-img absolute max-h-[420px] object-contain transition-all duration-500 opacity-0 scale-95 pointer-events-none">
        </div>
      </div>

      <!-- Columna Derecha: Tarjetas que comandan el Scroll -->
      <div class="lg:col-span-7 space-y-24 py-8">
        
        <!-- 1. Cobre-Ni -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#00D2D3]" data-product="img-cobre-ni" data-color="#00D2D3">
          <span class="text-xs font-bold uppercase tracking-wider text-[#00D2D3]">Sanidad Multisitio</span>          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Crop Cobre-Ni</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Bioestimulación sistémica, sanidad y balance mineral. Protección multisitio contra hongos y bacterias sin generar resistencia.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Cobre-Ni" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

        <!-- 2. Force -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#18D253]" data-product="img-force" data-color="#18D253">
          <span class="text-xs font-bold uppercase tracking-wider text-[#18D253]">Desarrollo Radicular</span>
          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Crop-Force</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Regulador fisiológico y promotor de crecimiento radicular para arranque vigoroso de zafra y superación de estrés térmico.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Force" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

        <!-- 3. Fix -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#00A8FF]" data-product="img-fix" data-color="#00A8FF">
          <span class="text-xs font-bold uppercase tracking-wider text-[#00A8FF]">Acondicionador Hídrico</span>
          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Crop-Fix</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Regulador de pH y secuestrante de sales para el agua de pulverización. Reduce evaporación y garantiza adherencia.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Fix" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

        <!-- 4. Citrus -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#FFA000]" data-product="img-citrus" data-color="#FFA000">
          <span class="text-xs font-bold uppercase tracking-wider text-[#FFA000]">Aceite de Naranja & Terpenos</span>
          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Crop-Citrus</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Adyuvante natural de alta penetración foliar. Acción translaminar total a los 20 minutos de aplicación.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Citrus" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

        <!-- 5. Aero-Tech -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#FF9100]" data-product="img-aero" data-color="#FF9100">
          <span class="text-xs font-bold uppercase tracking-wider text-[#FF9100]">Aviación & Drones ULV</span>
          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Aero-Tech</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Formulado para aplicaciones de ultra bajo volumen. Cero evaporación de gotas finas en vuelo con DJI Agras y aviones agrícolas.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Aero-Tech" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

        <!-- 6. Fixer Oil -->
        <div class="sercrop-card bg-slate-900/80 backdrop-blur border border-slate-800 p-8 rounded-2xl border-l-4 border-[#10AC84]" data-product="img-oil" data-color="#10AC84">
          <span class="text-xs font-bold uppercase tracking-wider text-[#10AC84]">Coadyuvante de Choque</span>
          <h3 class="text-3xl font-extrabold text-white mt-1 mb-3">Crop-Fixer Oil</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Diseñado para disolver ceras cuticulares gruesas, asegurando el ingreso total de moléculas sistémicas en malezas duras.</p>
          <a href="https://wa.me/595975679274?text=Cotizacion%20Crop-Fixer-Oil" target="_blank" class="rounded-full py-2.5 px-6 font-bold text-xs uppercase tracking-wider text-white bg-[#EA580C] hover:bg-[#C2410C] inline-block transition">Cotizar Lote</a>
        </div>

      </div>

    </div>
  </div>

  <!-- Script que detecta el scroll y conmuta la botella -->
  <script is:inline>
    const cards = document.querySelectorAll('.sercrop-card');
    const images = document.querySelectorAll('.sercrop-stage-img');
    const glow = document.getElementById('sercrop-glow');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const targetImgId = entry.target.getAttribute('data-product');
          const targetColor = entry.target.getAttribute('data-color');

          if (glow && targetColor) {
            glow.style.backgroundColor = targetColor;
          }

          images.forEach(img => {
            if (img.id === targetImgId) {
              img.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
              img.classList.add('opacity-100', 'scale-100');
            } else {
              img.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
              img.classList.remove('opacity-100', 'scale-100');
            }
          });
        }
      });
    }, { threshold: 0.5 });

    cards.forEach(card => observer.observe(card));
  </script>
</section><!-- LÍNEA SERCROP: ESCENARIO MONUMENTAL (100% PANTALLA FIJA POR PRODUCTO) -->
<section id="sercrop" class="relative bg-[#050B07] text-white">
  
  <!-- Contenedor con altura de scroll (600vh = 100vh por cada uno de los 6 productos) -->
  <div id="sercrop-stage-container" class="relative h-[600vh]">
    
    <!-- Escenario fijo a pantalla completa (100vh) -->
    <div class="sticky top-0 h-screen w-full flex flex-col justify-between overflow-hidden px-6 sm:px-12 lg:px-20 py-8 z-10">
      
      <!-- Barra Superior: Identidad y Paginador -->
